# Copy this file to .env and adjust values as needed for local development.

# Required by agencyos service. Example points to local postgres container.
DATABASE_URL=postgresql://agencyos:agencyos_dev@postgres:5432/agencyos

# Shared JWT secret with WBIT Portal — must match the JWT_SECRET in portal.wbit.app.
# Used to validate portal-issued JWTs during cross-app authentication.
JWT_SECRET=dev-secret-change-me

# WorkPipe backend API URL (host machine default for local integration).
WORKPIPE_API_URL=http://host.docker.internal:3000

# Secret key for Web UI integration.
WEBUI_SECRET_KEY=dev-secret

# Dev/test only — allow X-Org-Id header fallback to satisfy require_app_access checks.
# DO NOT SET IN PRODUCTION. Production must rely on Portal JWTs only.
# AGENCYOS_DEV_ALLOW_HEADER_AUTH=1

# --- WBIT Cortex bridge (thin-transport chat) -------------------------------
# When enabled, AgencyOS forwards every chat turn to the Cortex WBIT Assistant
# (block-and-return) instead of the legacy local lane/intent/model routing.
# Leave disabled to keep the legacy path.
WBIT_BRIDGE_ENABLED=false
# Cortex WBIT bridge plugin endpoint (block-and-return /chat).
CORTEX_BRIDGE_URL=https://cortex-prod-we61.onrender.com/api/plugins/bad9f2f7-f128-4d36-808e-1bf6f05e5150/api/chat
# Shared secret for the bridge (x-wbit-bridge-secret header). Set in prod env only.
WBIT_BRIDGE_SECRET=
# The single WBIT Assistant agent the bridge routes to.
WBIT_AGENT_ID=14d3caab-5d9f-4bec-881b-c5691f8d6ed9
# v1: a single configured Cortex company. Per-org resolution is blocked on #60.
WBIT_COMPANY_ID=
# Client timeout (s); the bridge blocks up to 120s, so keep this above that.
CORTEX_BRIDGE_TIMEOUT_S=125
